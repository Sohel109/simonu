# ========================================
# EXEMPLE DE CONFIGURATION ENVIRONNEMENT
# ========================================
# NE PAS COMMITER CE FICHIER AVEC VOS VRAIES VALEURS !
# Copier ce fichier en .env et remplacer les valeurs

# Configuration Email (Gmail App Password)
EMAIL_USER=votre-email@gmail.com
EMAIL_PASS=votre-app-password-gmail

# Port du serveur backend (optionnel, défaut: 3001)
PORT=3001

# URL du frontend pour CORS (en production)
FRONTEND_URL=https://votre-site.vercel.app

# Environnement
NODE_ENV=development
